&clk_lsi {
	status = "okay";
};

&clk_hsi {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&pll {
	div-m = <1>;
	mul-n = <20>;
	div-p = <2>;
	div-q = <8>;
	div-r = <2>;
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	stop-bits = "1";
	data-bits = <8>;
	status = "okay";
};


&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(34)>;
		};
		slot0_partition: partition@8800 {
			label = "image-0";
			reg = <0x00008800 DT_SIZE_K(234)>;
		};
		slot1_partition: partition@44800 {
			label = "image-1";
			reg = <0x00044800 DT_SIZE_K(234)>;
		};
		/* Set 10Kb of storage at the end of the 512Kb of flash */
		storage_partition: partition@7f000 {
			label = "storage";
			reg = <0x0007f000 DT_SIZE_K(10)>;
		};
	};
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};

&adc1 {
	pinctrl-0 = <&adc1_in8_pc2>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&vref {
	status = "okay";
};

&vbat {
	status = "okay";
};

&spi4 {
	pinctrl-0 = <&spi4_nss_pe4 &spi4_sck_pe2 &spi4_miso_pe5 &spi4_mosi_pe6>;
	pinctrl-names = "default";

	status = "okay";

	bt81x: bt81x@0 {
		compatible = "bridgetek,bt81x";

		reg = <0x0>;
		spi-max-frequency = <30000000>;
		irq-gpios = <&gpioe 1 GPIO_ACTIVE_LOW>;

		hsize = <800>;
		vsize = <480>;
		hcycle = <816>;
		hoffset = <8>;
		hsync0 = <0>;
		hsync1 = <4>;
		vcycle = <496>;
		voffset = <8>;
		vsync0 = <0>;
		vsync1 = <4>;
		pclk = <1>;
		swizzle = <0>;
		pclk_pol = <1>;
		cspread = <0>;
		dither = <0>;
		pclk_freq = <3348>;
		pclk_2x = <0>;

		status = "okay";
	};
};

&usb {
	status = "okay";
};
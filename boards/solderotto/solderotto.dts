/dts-v1/;
#include <st/g4/stm32g474Xe.dtsi>
#include <st/g4/stm32g474q(b-c-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Vendor solderotto board";
	compatible = "st,solderotto";

	chosen {
		zephyr,console = &rtt0;
		zephyr,shell-uart = &rtt0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	rtt0: rtt_chan0 {
		compatible = "segger,rtt-uart";
		status = "okay";
	};

	channel_out {
		compatible = "gpio-leds";
		sel_1a: sel_1a{
			gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
		};
		sel_2a: sel_2a {
			gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
		};
		sel_1b: sel_1b {
			gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
		};
		sel_2b: sel_2b {
			gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
		};
		load_0: load0 {
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
		};
		load_1: load1 {
			gpios = <&gpioc 14 GPIO_ACTIVE_HIGH>;
		};
		dbg_0: dbg_0 {
			gpios = <&gpioc 9 GPIO_OPEN_DRAIN>;
		};
		dbg_1: dbg_1 {
			gpios = <&gpioc 8 GPIO_OPEN_DRAIN>;
		};
		dbg_2: dbg_2 {
			gpios = <&gpioc 7 GPIO_OPEN_DRAIN>;
		};
		dbg_3: dbg_3 {
			gpios = <&gpioc 6 GPIO_OPEN_DRAIN>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		zcd0: zcd_0 {
			gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;
			label = "zcd";
		};
	};

	aliases {
		volt-sensor0 = &vref;
		volt-sensor1 = &vbat;
		ch0-sel-1a = &sel_1a;
		ch0-sel-2a = &sel_2a;
		ch0-sel-1b = &sel_1b;
		ch0-sel-2b = &sel_2b;
		ch0-load-a = &load_0;
		ch0-load-b = &load_1;
		zcd = &zcd0;
		dbg-0 = &dbg_0;
		dbg-1 = &dbg_1;
		dbg-2 = &dbg_2;
		dbg-3 = &dbg_3;
	};

	soc {
		quadspi: quadspi@a0001000 {
			compatible = "st,stm32-qspi";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0xa0001000 0x400>;
			interrupts = <71 0>;
			clocks = <&rcc STM32_CLOCK_BUS_AHB3 0x00000100>;
			status = "disabled";
		};
	};
};

&dma2 {
	status = "okay";
};


device stm32g474re
si SWD
speed 4000
connect
sleep 400
w4 0x40022008 0x45670123 // Send KEY1
w4 0x40022008 0xCDEF89AB // Send KEY2
w4 0x4002200C 0x08192A3B // Send OPTKEY1
w4 0x4002200C 0x4C5D6E7F // Send OPTKEY2
sleep 50
w4 0x1FFF7800 0xFFAFF8AA
sleep 50
w4 0x40022014 0x00020000 // Set OPTSTART bit of the FLASH_CR
sleep 50
